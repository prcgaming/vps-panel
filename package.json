{
  "name": "vps-panel-root",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Node VPS Control Panel with Hybrid Virtualization (Docker / KVM / Mock) & Web Terminal",
  "scripts": {
    "install:all": "cmd.exe /c \"cd apps/server && npm install && cd ../client && npm install && cd ../agent && npm install\"",
    "build:client": "cmd.exe /c \"cd apps/client && npm run build\"",
    "build:server": "cmd.exe /c \"cd apps/server && npm run build\"",
    "dev:server": "cmd.exe /c \"cd apps/server && npm run dev\"",
    "dev:client": "cmd.exe /c \"cd apps/client && npm run dev\"",
    "dev:agent": "cmd.exe /c \"cd apps/agent && npm run dev\"",
    "start:server": "cmd.exe /c \"cd apps/server && npm start\"",
    "start:agent": "cmd.exe /c \"cd apps/agent && npm start\""
  },
  "keywords": ["vps", "control-panel", "multi-node", "kvm", "docker", "admin-panel"],
  "author": "Antigravity",
  "license": "MIT"
}
